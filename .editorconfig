root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 200

[*.md]
trim_trailing_whitespace = false

[*.{bat,ps1}]
end_of_line = crlf

[scripts/setup.ps1]
charset = utf-8-bom
